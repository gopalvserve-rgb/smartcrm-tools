# Copy to .env for local dev. On Railway these are set as service variables.
NODE_ENV=production
PORT=3000

# MongoDB — Railway provides this automatically when a MongoDB plugin is attached.
MONGO_URL=mongodb://127.0.0.1:27017/smartcrm_tools

# Security — set a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret

# Seed super-admin (first boot only)
ADMIN_EMAIL=gopalvserve@gmail.com
ADMIN_PASSWORD=Admin@12345

# Optional: push captured leads into SmartCRM
SMARTCRM_API_URL=
SMARTCRM_API_KEY=
